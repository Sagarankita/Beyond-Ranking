{
  "schema_version": 1,
  "run_id_prefix": "phase5-pilot-synthetic",
  "allocation_config": "configs/allocation/legacy_synthetic_method_fixture.json",
  "seed": 42,
  "algorithm_api_review": {
    "reviewed_on": "2026-10-26",
    "external_library_reviewed": "pymoo official 0.6.2 documentation",
    "official_pages": [
      "https://pymoo.org/algorithms/moo/nsga3.html",
      "https://pymoo.org/algorithms/moo/moead.html",
      "https://pymoo.org/algorithms/moo/mopso_cd.html",
      "https://pymoo.org/customization/mixed.html"
    ],
    "decision": "repository_native_adapters",
    "reason": "Preserve the existing shared mixed-variable repair, feasibility-first dominance, evaluation cache, and result schema without a second problem translation layer."
