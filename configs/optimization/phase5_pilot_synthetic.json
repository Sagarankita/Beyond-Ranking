      "generations": 4
    },
    "moead": {
      "enabled": true,
      "reference_partitions": 3,
      "neighborhood_size": 5,
      "max_replacements": 2,
      "generations": 4
    },
    "mopso": {
      "enabled": true,
      "population_size": 20,
      "generations": 4,
      "archive_size": 20,
      "inertia": 0.6,
      "cognitive": 1.5,
      "social": 1.5,
      "maximum_velocity_rate": 0.2
    },
    "rion": {
      "enabled": true,
      "population_size": 20,
      "generations": 4,
      "pso_iterations": 2
    },
    "random_search": {
      "enabled": true,
      "evaluations": 100
    }
  },
  "output_root": "results/allocation_runs"
}
